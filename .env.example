# Copy to .env.local; replace blanks locally. NEVER commit live secrets.
# Public values are shipped to the browser by Next.js.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_STUDIO_URL=/studio
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only; leave blank unless the feature is enabled.
SANITY_VIEWER_TOKEN=
BREVO_API_KEY=
# Additional Brevo list IDs are configured in lib/brevo/lists.ts.
